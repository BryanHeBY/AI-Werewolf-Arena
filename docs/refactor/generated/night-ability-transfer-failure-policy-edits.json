    {
      "path": "backend/tests/unit/mechanisms/night-ability-transfer-failure-policy.test.ts",
      "beforeSHA256": null,
      "afterSHA256": "47632ecfc3d83ffa3d2d8c723012b413d3d050cc5a43b902c9da3ad2f41238ed",
      "wholePreciseForwardSame": true,
