  "semanticReview": [
    {
      "branch": "legal null",
      "source": "backend/src/features/wall-notes/window.ts:135",
      "conclusion": "原全局/作者/current复验通过，readWallTool(null)返回null，无rejected、无库存写，新增complete后继续；true表示本次可选处理已落定。"
    },
    {
      "branch": "invalid non-null shape",
      "source": "backend/src/features/wall-notes/window.ts:136",
      "conclusion": "原readWallTool接受域及异常转null不变，先成功追加rejected再complete；reject push抛错不会走到true。"
    },
    {
      "branch": "explicit gateway rejection",
      "source": "backend/src/features/wall-notes/window.ts:149",
      "conclusion": "原gateway读取/调用与第二次sameWallAuthor/current仍先执行，随后原rejected事实成功才新增complete；不付款、不造accepted。"
    },
    {
      "branch": "revocation/provider failure",
      "source": "backend/src/features/wall-notes/window.ts:120",
      "conclusion": "原首Provider失败、全局失效/撤销和作者撤销分支保持；未处理的delivery在原finally false关闭，不通过新增分支发true。"
    },
    {
      "branch": "paid and late effects",
      "source": "backend/src/features/wall-notes/window.ts:159",
      "conclusion": "原author.remaining=0→note.remaining=0→complete→accepted→收集原体未改。晚过滤/RNG/order/published或后续作者失败不撤销已完成前缀，无退款。"
    },
    {
      "branch": "complete callback throws",
      "source": "backend/src/domain/request-lease.ts:442",
      "conclusion": "finish先closed/settled/clear aliases，settleRequestDelivery先delete callback再通知；deferred Trace先outcome/settleOrder再onChange。回调抛错不回到decide内部catch，不二次false；原窗口catch/finally继续原错误规则。"
    },
    {
      "branch": "cleanup and error priority",
      "source": "backend/src/features/wall-notes/window.ts:203",
      "conclusion": "完整catch/finally逐字保留：body失败置failed，closeWall/expired失败置failed并覆盖body，所有delivery逐一close且记首新通知错；仅没有旧body/cleanup错才抛通知错。布尔failed能保throw undefined。"
    },
    {
      "branch": "Trace versus recorded replay",
      "source": "backend/src/recording/reproduction/trace.ts:137",
      "conclusion": "complete(true)保原候选（含null/shape-invalid），false仍是decision_failed；RecordedActions按相同请求与settleOrder把action候选返回或error抛出，未改schema/genericfallback。"
    }
  ],
