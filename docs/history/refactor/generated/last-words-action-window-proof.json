  "movedMethod": {
    "originalPhysicalLines": 93,
    "originalText": "private async collectLastWords(\n    deadIds: EntityId[],\n    phase: Phase,\n    deathPhase: Phase,\n    sources: DeathSources,\n    actionProvider: ActionProvider,\n    deathPhases: Readonly<Record<EntityId, Phase>>,\n    scopeCurrent: () => boolean = () => true,\n    policy: LastWordsPolicy = \"awa_initial_wave_v1\",\n    wordsContext?: LastWordsGrantContext,\n  ): Promise<void> {\n    const requests = new GameActionRequestFactory(this.world, this.events, this.state.day);\n    const day = this.state.day;\n    for (const deadId of deadIds) {\n      const actualDeathPhase = deathPhases[deadId] ?? deathPhase;\n      if (\n        !this.lastWordsMechanism.shouldGrantLastWords(\n          actualDeathPhase,\n          day,\n          sources[deadId] ?? [],\n          policy,\n          wordsContext,\n        )\n      )\n        continue;\n      if (\n        !scopeCurrent() ||\n        this.state.phase !== phase ||\n        this.state.day !== day ||\n        this.state.gameOver\n      )\n        return;\n      const permit = this.world.openDeathAction(deadId, \"speak\", phase, day, scopeCurrent);\n      try {\n        const request = requests.create({\n          phase,\n          actorId: deadId,\n          allowedTools: [\"speak\"],\n          stage: \"last_words\",\n          requiresAction: true,\n          summary: { key: \"request.summary.last_words\" },\n          context: {\n            trigger: \"last_words\",\n            death_phase: actualDeathPhase,\n            death_action_id: permit.id,\n          },\n        });\n        if (!scopeCurrent() || !this.world.hasDeathAction(deadId, \"speak\", phase, day, permit.id))\n          return;\n        const action = await actionProvider.getAction(request);\n        if (\n          !scopeCurrent() ||\n          this.state.phase !== phase ||\n          this.state.day !== day ||\n          this.state.gameOver ||\n          !this.world.hasDeathAction(deadId, \"speak\", phase, day, permit.id)\n        )\n          return;\n        if (action?.name !== \"speak\") {\n          continue;\n        }\n        const validated = this.toolGateway.validateAndSanitize(this.world, deadId, action, {\n          phase,\n          day: this.state.day,\n          deathActionId: permit.id,\n        });\n        if (!validated.ok || !validated.sanitizedCall) {\n          continue;\n        }\n        if (\n          !scopeCurrent() ||\n          this.state.phase !== phase ||\n          this.state.day !== day ||\n          this.state.gameOver ||\n          !this.world.hasDeathAction(deadId, \"speak\", phase, day, permit.id)\n        )\n          return;\n        this.events.push({\n          timestamp: Date.now(),\n          type: \"last_words_spoken\",\n          payload: {\n            playerId: deadId,\n            phase,\n            day: this.state.day,\n            text: validated.sanitizedCall.args.text,\n          },\n        });\n      } finally {\n        permit.close();\n      }\n    }\n  }",
    "actualNewText": "async collect(\n    deadIds: EntityId[],\n    phase: Phase,\n    deathPhase: Phase,\n    sources: DeathSources,\n    actionProvider: ActionProvider,\n    deathPhases: Readonly<Record<EntityId, Phase>>,\n    scopeCurrent: () => boolean = () => true,\n    policy: LastWordsPolicy = \"awa_initial_wave_v1\",\n    wordsContext?: LastWordsGrantContext,\n  ): Promise<void> {\n    // 构造器先查询，再按原顺序取 World／事件／第一次日期；构造完成后另读本次收集日期。\n    const requests = new this.runtime.requestFactory(this.runtime.world, this.runtime.events, this.runtime.state.day);\n    const day = this.runtime.state.day;\n    for (const deadId of deadIds) {\n      // 来源阶段与政策先于当前性和许可；不以授予事件或请求字段代替 World 的原生命绑定。\n      const actualDeathPhase = deathPhases[deadId] ?? deathPhase;\n      if (\n        !this.runtime.lastWordsMechanism.shouldGrantLastWords(\n          actualDeathPhase,\n          day,\n          sources[deadId] ?? [],\n          policy,\n          wordsContext,\n        )\n      )\n        continue;\n      if (\n        !scopeCurrent() ||\n        this.runtime.state.phase !== phase ||\n        this.runtime.state.day !== day ||\n        this.runtime.state.gameOver\n      )\n        return;\n      // 开放抛错仍发生在 try 外；开放成功后，所有 return／continue 与原异常都经过 finally。\n      const permit = this.runtime.world.openDeathAction(deadId, \"speak\", phase, day, scopeCurrent);\n      try {\n        const request = requests.create({\n          phase,\n          actorId: deadId,\n          allowedTools: [\"speak\"],\n          stage: \"last_words\",\n          requiresAction: true,\n          summary: { key: \"request.summary.last_words\" },\n          context: {\n            trigger: \"last_words\",\n            death_phase: actualDeathPhase,\n            death_action_id: permit.id,\n          },\n        });\n        if (!scopeCurrent() || !this.runtime.world.hasDeathAction(deadId, \"speak\", phase, day, permit.id))\n          return;\n        // 等待前后分别复验；回复不会重开已经撤销的生命许可。\n        const action = await actionProvider.getAction(request);\n        if (\n          !scopeCurrent() ||\n          this.runtime.state.phase !== phase ||\n          this.runtime.state.day !== day ||\n          this.runtime.state.gameOver ||\n          !this.runtime.world.hasDeathAction(deadId, \"speak\", phase, day, permit.id)\n        )\n          return;\n        if (action?.name !== \"speak\") {\n          continue;\n        }\n        const validated = this.runtime.toolGateway.validateAndSanitize(this.runtime.world, deadId, action, {\n          phase,\n          day: this.runtime.state.day,\n          deathActionId: permit.id,\n        });\n        if (!validated.ok || !validated.sanitizedCall) {\n          continue;\n        }\n        if (\n          !scopeCurrent() ||\n          this.runtime.state.phase !== phase ||\n          this.runtime.state.day !== day ||\n          this.runtime.state.gameOver ||\n          !this.runtime.world.hasDeathAction(deadId, \"speak\", phase, day, permit.id)\n        )\n          return;\n        // 保留 push callee→时间戳→日次→清洗后文字的原读取点，发表失败不回滚已完成前缀。\n        this.runtime.events.push({\n          timestamp: Date.now(),\n          type: \"last_words_spoken\",\n          payload: {\n            playerId: deadId,\n            phase,\n            day: this.runtime.state.day,\n            text: validated.sanitizedCall.args.text,\n          },\n        });\n      } finally {\n        // 不捕获关闭错误；close 抛错仍按原 finally 语义覆盖正在传播的正文错误。\n        permit.close();\n      }\n    }\n  }",
