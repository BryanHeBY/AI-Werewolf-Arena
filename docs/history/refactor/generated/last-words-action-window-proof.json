n          this.state.phase !== phase ||\n          this.state.day !== day ||\n          this.state.gameOver ||\n          !this.world.hasDeathAction(deadId, \"speak\", phase, day, permit.id)\n        )\n          return;\n        if (action?.name !== \"speak\") {\n          continue;\n        }\n        const validated = this.toolGateway.validateAndSanitize(this.world, deadId, action, {\n          phase,\n          day: this.state.day,\n          deathActionId: permit.id,\n        });\n        if (!validated.ok || !validated.sanitizedCall) {\n          continue;\n        }\n        if (\n          !scopeCurrent() ||\n          this.state.phase !== phase ||\n          this.state.day !== day ||\n          this.state.gameOver ||\n          !this.world.hasDeathAction(deadId, \"speak\", phase, day, permit.id)\n        )\n          return;\n        // 保留 push callee→时间戳→日次→清洗后文字的原读取点，发表失败不回滚已完成前缀。\n        this.events.push({\n          timestamp: Date.now(),\n          type: \"last_words_spoken\",\n          payload: {\n            playerId: deadId,\n            phase,\n            day: this.state.day,\n            text: validated.sanitizedCall.args.text,\n          },\n        });\n      } finally {\n        // 不捕获关闭错误；close 抛错仍按原 finally 语义覆盖正在传播的正文错误。\n        permit.close();\n      }\n    }\n  }",
