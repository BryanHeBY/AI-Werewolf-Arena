{
  "name": "ai-werewolf-arena-backend",
  "version": "1.0.0",
  "description": "Backend game engine for AI Werewolf Arena",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --preload ./tests/setup.ts tests",
    "lint:deps": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:boundaries": "bun scripts/check_import_boundaries.mjs",
    "smoke": "bun src/run-game-smoke.ts",
    "release:check": "bun run check && bun run lint:deps && bun run lint:boundaries && bun run test && bun run smoke",
    "run": "bun src/runtime/cli/run_game.ts",
    "export:replay": "bun src/replay/export_replay_bundle.ts",
    "run:six": "bun src/runtime/cli/run_game.ts --game-config-name six_player_mvp",
    "run:twelve": "bun src/runtime/cli/run_game.ts --game-config-name twelve_player_standard",
    "run:twelve:acp": "bun src/runtime/cli/run_game.ts --game-config-name twelve_player_codex_acp",
    "run:mock": "bun src/runtime/run_mock_game.ts",
    "test:watch": "bun test --preload ./tests/setup.ts tests --watch",
    "test:coverage": "bun test --preload ./tests/setup.ts tests --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@ai-werewolf-arena/replay-contract": "workspace:*",
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.37",
    "dotenv": "^16.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.37.0",
    "typescript": "^5.3.3"
  }
}
