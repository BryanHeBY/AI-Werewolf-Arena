{
  "name": "ai-werewolf-arena-backend",
  "version": "1.0.0",
  "description": "Backend game engine for AI Werewolf Arena",
  "main": "./dist/server/index.js",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "build": "tsc",
    "build:v3": "tsc -p tsconfig.json --noEmit",
    "start": "bun dist/server/index.js",
    "test": "bun test",
    "test:v3": "bun test tests/v3",
    "test:quick": "bun test tests/v3/tool_gateway_validation.test.ts tests/v3/event_registry_hooks.test.ts tests/v3/phase_manager_mvp.test.ts tests/v3/day_interrupt_hooks.test.ts tests/v3/night_wolf_tactical_loop.test.ts",
    "test:full": "bun test tests/v3",
    "lint:deps": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:boundaries": "bun scripts/check_import_boundaries.mjs",
    "smoke:v3": "bun src/run-test-v3.ts",
    "release:check": "bun run build:v3 && bun run test:quick && bun run smoke:v3",
    "run:v3": "bun src/runtime/run_llm_game.ts",
    "export:replay": "bun src/replay/export_replay_bundle.ts",
    "run:v3:dual": "bun src/runtime/run_llm_dual.ts",
    "run:v3:six": "bun src/runtime/run_llm_game.ts --game-config-name six_minimax",
    "run:v3:twelve": "bun src/runtime/run_llm_game.ts --game-config-name twelve_minimax",
    "run:v3:mock": "bun src/runtime/run_mock_game.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "openai": "^4.28.0",
    "socket.io": "^4.7.4"
  },
  "devDependencies": {
    "@types/nock": "^10.0.3",
    "@types/node": "^20.11.19",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.37.0",
    "nock": "^14.0.11",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
