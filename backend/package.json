{
  "name": "ai-werewolf-arena-backend",
  "version": "1.0.0",
  "description": "Backend game engine for AI Werewolf Arena",
  "main": "./dist/server/index.js",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "build": "tsc",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "bun dist/server/index.js",
    "test": "bun test tests",
    "lint:deps": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:boundaries": "bun scripts/check_import_boundaries.mjs",
    "smoke": "bun src/run-game-smoke.ts",
    "release:check": "bun run check && bun run test && bun run smoke",
    "run": "bun src/runtime/run_llm_game.ts",
    "export:replay": "bun src/replay/export_replay_bundle.ts",
    "run:dual": "bun src/runtime/run_llm_dual.ts",
    "run:six": "bun src/runtime/run_llm_game.ts --game-config-name six_player_mvp",
    "run:twelve": "bun src/runtime/run_llm_game.ts --game-config-name twelve_player_standard",
    "run:twelve:acp": "bun src/runtime/run_llm_game.ts --game-config-name twelve_player_codex_acp",
    "run:mock": "bun src/runtime/run_mock_game.ts",
    "test:watch": "bun test tests --watch",
    "test:coverage": "bun test tests --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@ai-sdk/anthropic": "^4.0.21",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@fastify/cors": "^8.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.37",
    "dotenv": "^16.4.1",
    "fastify": "^4.26.0",
    "socket.io": "^4.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nock": "^10.0.3",
    "@types/node": "^20.11.19",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.37.0",
    "nock": "^14.0.11",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
