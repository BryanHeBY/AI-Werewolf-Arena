{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node", "bun-types", "bun-types/test-globals"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"]
}
