{
  "default": "openrouter",
  "items": {
    "openrouter": {
      "type": "openai",
      "apiKey": "${OPENROUTER_API_KEY}",
      "baseURL": "https://openrouter.ai/api/v1",
      "userAgent": "AWA-Werewolf/1.0",
      "maxConcurrentRequests": 8
    },
    "acp_local": {
      "type": "acp",
      "transport": "stdio",
      "command": "your-acp-agent",
      "args": ["--acp"],
      "env": {},
      "maxConcurrentSessions": 12
    }
  }
}
