{
  "name": "@ai-werewolf-arena/game-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "bun src/cli/run-game.ts",
    "run:six": "bun src/cli/run-game.ts --game-config-name six_player_mvp",
    "run:twelve": "bun src/cli/run-game.ts --game-config-name twelve_player_standard",
    "run:twelve:acp": "bun src/cli/run-game.ts --game-config-name twelve_player_codex_acp",
    "run:mock": "bun src/run-mock-game.ts",
    "smoke": "bun src/cli/run-game-smoke.ts",
    "config:check": "bun src/cli/check-config.ts",
    "config:migrate": "bun src/cli/migrate-configs.ts",
    "export:replay": "bun src/cli/export-replay-bundle.ts",
    "simulate": "bun src/cli/simulate.ts",
    "replay:actions": "bun src/cli/replay-actions.ts",
    "check": "bun --bun tsc --noEmit",
    "test": "bun --no-env-file test tests"
  },
  "dependencies": {
    "@ai-werewolf-arena/game-runtime": "workspace:*",
    "@ai-werewolf-arena/game-contract": "workspace:*",
    "@ai-werewolf-arena/game-text": "workspace:*",
    "@ai-werewolf-arena/replay-contract": "workspace:*",
    "@ai-werewolf-arena/project-paths": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "bun-types": "^1.4.2",
    "@types/node": "^20.19.43"
  }
}
