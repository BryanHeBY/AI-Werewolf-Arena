{
  "name": "ai-werewolf-arena-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx vite",
    "replay:dev": "bun scripts/replay-dev.ts",
    "build": "bunx vite build",
    "preview": "bunx vite preview",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test tests/unit",
    "test:e2e": "http_proxy= https_proxy= all_proxy= HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= bun ./node_modules/@playwright/test/cli.js test",
    "test:ui": "bun ./node_modules/@playwright/test/cli.js test --ui",
    "replay:render": "bun scripts/render-replay.ts"
  },
  "dependencies": {
    "@ai-werewolf-arena/replay-contract": "workspace:*",
    "@remotion/player": "^4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "@ai-werewolf-arena/game-catalog": "workspace:*",
    "@ai-werewolf-arena/game-text": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "^1.4.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
