{
  "name": "ai-werewolf-arena-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./appearance": "./src/workbench-appearance.ts",
    "./replay": "./src/workbench-replay.tsx",
    "./style.css": "./src/style.css"
  },
  "scripts": {
    "dev": "bunx vite",
    "replay:dev": "bun scripts/replay-dev.ts",
    "build": "bunx vite build",
    "preview": "bunx vite preview",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun run test:unit && bun run test:integration && bun run test:architecture",
    "test:e2e": "http_proxy= https_proxy= all_proxy= HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= bun ./node_modules/@playwright/test/cli.js test",
    "test:ui": "bun ./node_modules/@playwright/test/cli.js test --ui",
    "replay:render": "bun scripts/render-replay.ts",
    "video:render": "bun scripts/render-video.ts",
    "video:preview": "bun scripts/preview-video.ts",
    "video:inspect": "bun scripts/inspect-video.ts",
    "video:voices": "bun scripts/prepare-voices.ts",
    "video:script": "bun --no-env-file scripts/generate-video-script.ts",
    "video:speech-script": "bun --no-env-file scripts/generate-speech-script.ts",
    "video:speech-compile": "bun --no-env-file scripts/compile-speech-video.ts",
    "video:estimate": "bun --no-env-file scripts/estimate-video-duration.ts",
    "video:subtitles": "bun --no-env-file scripts/export-video-subtitles.ts",
    "video:audit": "bun --no-env-file scripts/audit-video.ts",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:architecture": "bun --no-env-file test tests/architecture",
    "video:render-production": "bun --no-env-file scripts/render-production-video.ts",
    "video:soundtrack": "bun --no-env-file scripts/mix-video-soundtrack.ts",
    "video:soundtrack-mux": "bun --no-env-file scripts/mux-video-soundtrack.ts",
    "video:produce": "bun --no-env-file scripts/produce-video.ts",
    "video:review": "bun --no-env-file scripts/serve-video-review.ts",
    "video:verify": "bun --no-env-file scripts/verify-video-artifact.ts",
    "video:audio": "bun --no-env-file scripts/prepare-video-audio.ts"
  },
  "dependencies": {
    "@ai-werewolf-arena/replay-contract": "workspace:*",
    "@remotion/player": "^4.0.529",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.529",
    "@ai-werewolf-arena/game-catalog": "workspace:*",
    "@ai-werewolf-arena/game-text": "workspace:*",
    "@ai-werewolf-arena/game-presentation": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "^1.4.2",
    "eslint": "9.39.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "@ai-werewolf-arena/game-contract": "workspace:*"
  }
}
