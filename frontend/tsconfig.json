{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["bun-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/replay/**/*.ts",
    "src/replay/**/*.tsx",
    "tests/replay/**/*.ts",
    "scripts/render-replay.ts",
    "tests/unit/replay/replay-display.test.tsx",
    "tests/unit/replay/render-replay.test.ts",
    "tests/unit/replay/replay-cli.test.ts",
    "tests/e2e/offline-replay.spec.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
