{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["bun-types", "node"],
    "typeRoots": [
      "../packages/game-runtime/node_modules",
      "../packages/game-runtime/node_modules/@types"
    ],
    "paths": {
      "typescript": ["../packages/game-runtime/node_modules/typescript"]
    }
  },
  "include": ["**/*.ts"]
}
