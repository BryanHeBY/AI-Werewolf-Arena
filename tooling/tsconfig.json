{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["bun-types", "node"],
    "typeRoots": ["../backend/node_modules", "../backend/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "typescript": ["../backend/node_modules/typescript"]
    }
  },
  "include": ["**/*.ts"]
}
