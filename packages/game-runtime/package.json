{
  "name": "@ai-werewolf-arena/game-runtime",
  "version": "1.0.0",
  "description": "Game rules, agents, recording and run orchestration without process entrypoints",
  "main": "./dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./config/parse": "./src/app/config/parse-config.ts",
    "./config/board": "./src/app/config/board-definition.ts",
    "./config/resolve": "./src/app/config/resolve-game-setup.ts",
    "./config/check": "./src/app/config/check-config.ts",
    "./config/diagnostics": "./src/app/config/error-codes.ts",
    "./config/models": "./src/app/config/model-catalog.ts",
    "./config/validate": "./src/app/config/validate-runtime-config.ts",
    "./run-session": "./src/app/run-session.ts",
    "./app/config/load-config": "./src/app/config/load-config.ts",
    "./app/config/validate-runtime-config": "./src/app/config/validate-runtime-config.ts",
    "./app/config/load-board-definition": "./src/app/config/load-board-definition.ts",
    "./app/config/resolve-game-setup": "./src/app/config/resolve-game-setup.ts",
    "./app/config/describe-setup": "./src/app/config/describe-setup.ts",
    "./app/config/error-codes": "./src/app/config/error-codes.ts",
    "./utils/error-diagnostic": "./src/utils/error-diagnostic.ts",
    "./recording/session/recorder": "./src/recording/session/recorder.ts",
    "./app/config/migrate-runtime": "./src/app/config/migrate-runtime.ts",
    "./app/config/migrate-board": "./src/app/config/migrate-board.ts",
    "./app/config/board-definition": "./src/app/config/board-definition.ts",
    "./rulesets/presets/board-config-resolver": "./src/rulesets/presets/board-config-resolver.ts",
    "./app/simulation/replay-reproduction": "./src/app/simulation/replay-reproduction.ts",
    "./app/game-runner": "./src/app/game-runner.ts",
    "./app/config/contracts": "./src/app/config/contracts.ts",
    "./app/run-session": "./src/app/run-session.ts",
    "./app/simulation/simulate-games": "./src/app/simulation/simulate-games.ts",
    "./app/bootstrap": "./src/app/bootstrap.ts",
    "./rulesets/presets/six-player-mvp": "./src/rulesets/presets/six-player-mvp.ts",
    "./agents/baseline/privileged": "./src/agents/baseline/privileged.ts",
    "./config/rule-catalog": "./src/app/config/rule-catalog.ts",
    "./testing/fixtures": "./tests/support/fixtures/manifest.ts",
    "./config/test-agent-connection": "./src/app/config/test-agent-connection.ts"
  },
  "scripts": {
    "build": "bun --bun tsc",
    "check": "bun --bun tsc -p tsconfig.json --noEmit && bun run check:tests",
    "check:tests": "bun --bun tsc -p tsconfig.tests.json --noEmit",
    "test": "bun test --preload ./tests/setup.ts tests",
    "lint:deps": "bun --bun eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:boundaries": "bun scripts/check-import-boundaries.mjs",
    "test:watch": "bun test --preload ./tests/setup.ts tests --watch",
    "test:coverage": "bun test --preload ./tests/setup.ts tests --coverage",
    "lint:i18n": "bun scripts/check-i18n-literals.mjs",
    "test:unit": "bun --no-env-file test --preload ./tests/setup.ts tests/unit",
    "test:integration": "bun --no-env-file test --preload ./tests/setup.ts tests/integration",
    "test:scenarios": "bun --no-env-file test --preload ./tests/setup.ts tests/scenarios",
    "check:tooling": "bun --bun tsc -p ../../tooling/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-werewolf-arena/workbench-contract": "workspace:*",
    "@agentclientprotocol/sdk": "^1.5.1",
    "@ai-sdk/anthropic": "^4.0.65",
    "@ai-sdk/openai-compatible": "^3.0.57",
    "@ai-werewolf-arena/game-catalog": "workspace:*",
    "@ai-werewolf-arena/game-contract": "workspace:*",
    "@ai-werewolf-arena/game-presentation": "workspace:*",
    "@ai-werewolf-arena/game-text": "workspace:*",
    "@ai-werewolf-arena/replay-contract": "workspace:*",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ai": "^7.0.118",
    "typebox": "1.3.27",
    "zod": "^4.6.5",
    "@ai-werewolf-arena/project-paths": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "^1.4.2",
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  },
  "private": true
}
